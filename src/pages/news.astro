---
import Base from "../layouts/Base.astro";
import { getCollection, render } from "astro:content";

const news = (await getCollection("news")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const articles = await Promise.all(
  news.map(async (item) => {
    const { Content } = await render(item);
    return { item, Content };
  }),
);
---

<Base title="News">
  <div class="container">
    <h2><span>News</span></h2>
    <p class="code">The third digit of the code is 3</p>

    <ul>
      {
        articles.map(({ item, Content }) => (
          <li>
            <article>
              <h3>{item.data.title}</h3>

              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toDateString()}
              </time>

              <div class="md">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  ul > li:not(:last-child) {
    border-bottom: solid grey 1px;
    padding-bottom: var(--sp-l);
    margin-bottom: var(--sp-xl);
  }

  h3 {
    margin-bottom: var(--sp-2xs);
  }

  time {
    display: block;
    margin-bottom: var(--sp-l);
  }
</style>
